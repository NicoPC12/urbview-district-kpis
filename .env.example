# Copy to `.env` to override any value. NOT required: `docker compose up` works without it.
# Compose reads a sibling `.env` automatically; Django also reads it for native runs.
# Comments sit on their own line because not every dotenv parser strips trailing ones.

# --- PostgreSQL (Django ORM: districts and KPI definitions; no geometry) ------------------

# Database name.
POSTGRES_DB=urbview
# Database role.
POSTGRES_USER=urbview
# Local-only password. prod.py refuses to start without an explicit value.
POSTGRES_PASSWORD=urbview_dev
# Compose service name; use `localhost` for a native run against the published port.
POSTGRES_HOST=db
# Port inside the compose network.
POSTGRES_PORT=5432
# Port published on the host (change if 5432 is already taken).
POSTGRES_HOST_PORT=5432

# --- Django -----------------------------------------------------------------------------

# `config.settings.dev` or `config.settings.prod`; prod requires every secret below.
DJANGO_SETTINGS_MODULE=config.settings.dev
# Empty = dev fallback (`django-insecure-...`). REQUIRED in prod.
DJANGO_SECRET_KEY=
# Comma-separated hostnames. Prod only; dev allows every host.
DJANGO_ALLOWED_HOSTS=
# Root logger level.
LOG_LEVEL=INFO
# DuckDB file built by `make load-data` (container path; native runs default to ./data/).
WAREHOUSE_PATH=/data/warehouse.duckdb
# API port published on the host.
BACKEND_HOST_PORT=8000

# --- Frontend ---------------------------------------------------------------------------

# Vite dev server port published on the host.
FRONTEND_HOST_PORT=5173
# File polling for hot reload through Windows/macOS bind mounts. Set false on Linux.
VITE_USE_POLLING=true
# Where Vite proxies `/api`. Compose overrides this to the backend service.
VITE_API_PROXY_TARGET=http://localhost:8000
